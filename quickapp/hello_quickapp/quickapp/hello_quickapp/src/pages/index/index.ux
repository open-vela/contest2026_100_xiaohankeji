<template>
  <div class="page" onswipe="onSwipe">
    <text class="title">小涵打砖块</text>
    <text class="sub">小涵游戏开发</text>
    <div class="btn" onclick="go">
      <text class="btn-text">开始游戏</text>
    </div>
    <div class="btn2" onclick="goRecords">
      <text class="btn2-text">最高记录</text>
    </div>
    <div class="btn3" onclick="showSettings">
      <text class="btn3-text">设置</text>
    </div>

    <div if="{{ showPanel }}" class="panel" onclick="hidePanel">
      <div class="panel-box" onclick="stopProp">
        <text class="panel-title">操控方式</text>
        <div class="opt" onclick="setGyro">
          <text class="opt-text {{ controlMode === 0 ? 'opt-active' : '' }}">陀螺仪</text>
        </div>
        <div class="opt" onclick="setTouch">
          <text class="opt-text {{ controlMode === 1 ? 'opt-active' : '' }}">触控滑动</text>
        </div>
        <div class="close-btn" onclick="hidePanel">
          <text class="close-text">关闭</text>
        </div>
      </div>
    </div>
  </div>
</template>

<script>
import router from "@system.router"
import storage from "@system.storage"

export default {
  private: {
    controlMode: 0,
    showPanel: false
  },

  onInit() {
    var self = this
    storage.get({
      key: 'controlMode',
      success: function(data) {
        self.controlMode = parseInt(data) || 0
      }
    })
  },

  go() {
    router.push({
      uri: "/pages/level",
      params: { controlMode: this.controlMode }
    })
  },

  goRecords() {
    router.push({ uri: "/pages/record" })
  },

  onSwipe(e) {
    if (e.direction === 'left' || e.direction === 'down') {
      this.go()
    }
  },

  showSettings() {
    this.showPanel = true
  },

  hidePanel() {
    this.showPanel = false
  },

  stopProp() {},

  setGyro() {
    this.controlMode = 0
    storage.set({ key: 'controlMode', data: '0' })
  },

  setTouch() {
    this.controlMode = 1
    storage.set({ key: 'controlMode', data: '1' })
  }
}
</script>


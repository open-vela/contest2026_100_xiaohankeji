  font-size: 32px;
  color: #ffffff;
}

.btn2 {
  width: 240px;
  height: 56px;
  border-radius: 28px;
  background-color: #333333;
  justify-content: center;
  align-items: center;
  margin-bottom: 16px;
}

.btn2-text {
  font-size: 26px;
  color: #cccccc;
}

.btn3 {
  width: 240px;
  height: 56px;
  border-radius: 28px;
  background-color: #2a2a3e;
  justify-content: center;
  align-items: center;
}

.btn3-text {
  font-size: 26px;
  color: #cccccc;
}

.panel {
  position: absolute;
  left: 0;
  top: 0;
  width: 480px;
  height: 480px;
  background-color: rgba(0,0,0,0.85);
  justify-content: center;
  align-items: center;
  z-index: 20;
}

.panel-box {
  width: 340px;
  background-color: #1a1a2e;
  border-radius: 20px;
  flex-direction: column;
  align-items: center;
  padding-top: 30px;
  padding-bottom: 30px;
}

.panel-title {
  font-size: 28px;
  color: #ffffff;
  margin-bottom: 24px;
}

.opt {
  width: 260px;
  height: 56px;
  border-radius: 28px;
  background-color: #2a2a3e;
  justify-content: center;
  align-items: center;
  margin-bottom: 14px;
}

.opt-text {
  font-size: 24px;
  color: #888888;
}

.opt-active {
  color: #00ccff;
}

.close-btn {
  width: 260px;
  height: 50px;
  border-radius: 25px;
  background-color: #444444;
  justify-content: center;
  align-items: center;

  background-color: rgba(12,12,18,0.92);
  border-bottom-width: 1px;
  border-bottom-style: solid;
  border-bottom-color: rgba(255,255,255,0.08);
  flex-direction: column;
  justify-content: center;
  z-index: 8;
}

.info-item {
  flex-direction: row;
  justify-content: center;
  align-items: center;
}

.info-label {
  font-size: 17px;
  color: #8e8e93;
  margin-left: 8px;
  margin-right: 3px;
}

.info-value {
  font-size: 21px;
  color: #f2f2f7;
  margin-right: 10px;
}

@media screen and (shape: circle) {
  .info-bar {
    padding-left: 40px;
    padding-right: 40px;
  }
}

.brick {
  position: absolute;
  width: 52px;
  height: 18px;
  border-radius: 6px;
}

.paddle {
  position: absolute;
  height: 12px;
  border-radius: 6px;
  background-color: #22c1e8;
}

.ball {
  position: absolute;
  width: 24px;
  height: 24px;
  border-radius: 12px;
  background-color: #ffcc00;
}

.ball-white {
  background-color: #ffffff;
}

.ball-blue {
  position: absolute;
  width: 24px;
  height: 24px;
  border-radius: 12px;
  background-color: #3399ff;
}

.ready-hint {
  position: absolute;
  left: 0;
  top: 330px;
  width: 480px;
  text-align: center;
  font-size: 22px;
  color: rgba(255,255,255,0.55);
  z-index: 6;
}

.mask {
  position: absolute;
  left: 0;
  top: 0;
  width: 480px;
  height: 480px;
  background-color: rgba(0,0,0,0.72);
  justify-content: center;
  align-items: center;
  z-index: 10;
}

.mask-card {
  width: 340px;
  background-color: #14141c;
  border-width: 1px;
  border-style: solid;
  border-color: rgba(255,255,255,0.1);
  border-radius: 28px;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding-top: 30px;
  padding-bottom: 30px;
  padding-left: 20px;
  padding-right: 20px;
}

.msg {
  font-size: 38px;
  color: #f2f2f7;
  margin-bottom: 16px;
}

.hint {
  font-size: 19px;
  color: #ffcc00;
  margin-bottom: 10px;
}

.btn-pill {
  font-size: 18px;
  color: #8e8e93;
  background-color: rgba(255,255,255,0.08);
  border-radius: 22px;
  padding-left: 28px;
  padding-right: 28px;
  padding-top: 9px;
  padding-bottom: 9px;
  margin-top: 10px;
}

.star {
  position: absolute;
  background-color: #ffffff;
  border-radius: 50%;
}

.splash {
  position: absolute;
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background-color: #9fd8ff;
  z-index: 6;
}

.ripple {
  position: absolute;
  border-width: 2px;
  border-style: solid;
  border-color: #66ccff;
  border-radius: 50%;
  z-index: 5;
}

.edge-flash {
  position: absolute;
  left: 12px;
  top: 12px;
  width: 456px;
  height: 456px;
  border-width: 12px;
  border-style: solid;
  border-radius: 50%;
  z-index: 11;
}

.pop-wrap {
  position: absolute;
  z-index: 12;
  justify-content: center;
  align-items: center;
}

.pop-text {
  font-size: 26px;
  color: #ffffff;
  background-color: rgba(0,0,0,0.6);
  border-radius: 12px;
  padding-left: 12px;
  padding-right: 12px;
  padding-top: 4px;
  padding-bottom: 4px;
}
</style>
      <div class="brick" if="{{ b0a }}" style="left:{{ b0x }}px;top:{{ b0y }}px;background-color:{{ b0c }};{{ b0s }}"></div>
      <div class="brick" if="{{ b1a }}" style="left:{{ b1x }}px;top:{{ b1y }}px;background-color:{{ b1c }};{{ b1s }}"></div>

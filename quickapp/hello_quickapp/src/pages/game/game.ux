      <div class="star" style="left:{{ s9x }}px;top:{{ s9y }}px;width:{{ s9s }}px;height:{{ s9s }}px;opacity:{{ s9o }};"></div>
      <div class="star" style="left:{{ s10x }}px;top:{{ s10y }}px;width:{{ s10s }}px;height:{{ s10s }}px;opacity:{{ s10o }};"></div>
      <div class="star" style="left:{{ s11x }}px;top:{{ s11y }}px;width:{{ s11s }}px;height:{{ s11s }}px;opacity:{{ s11o }};"></div>


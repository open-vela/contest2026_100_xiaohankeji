<template>
  <div class="page" onswipe="onSwipe">
<text class="title" style="opacity:{{ oTitle }}">小涵打砖块</text>
    <div class="title-accent" style="opacity:{{ oAccent }}"></div>
    <text class="sub" style="opacity:{{ oSub }}">小涵游戏开发</text>
    <div class="btn" style="opacity:{{ oBtn1 }}" onclick="go">
      <text class="btn-text">开始游戏</text>
    </div>
    <div class="btn2" style="opacity:{{ oBtn2 }}" onclick="goRecords">
      <text class="btn2-text">更多数据</text>
    </div>
    <div class="btn3" style="opacity:{{ oBtn3 }}" onclick="showSettings">
      <text class="btn3-text">设置</text>
    </div>

    <div if="{{ showPanel }}" class="panel" onclick="hidePanel">
      <div class="panel-box" onclick="stopProp">
        <text class="panel-title">操控方式</text>
        <div class="opt" onclick="setGyro">
          <text class="opt-text {{ controlMode === 0 ? 'opt-active' : '' }}">体感操控优先</text>
        </div>
        <div class="opt" onclick="setTouch">
          <text class="opt-text {{ controlMode === 1 ? 'opt-active' : '' }}">仅滑动操控</text>
        </div>
        <div class="opt" onclick="calibrate">
          <text class="opt-text">体感校准</text>
        </div>
        <text class="calib-msg" if="{{ calibMsg !== '' }}">{{ calibMsg }}</text>
        <div class="close-btn" onclick="hidePanel">
          <text class="close-text">关闭</text>
        </div>
      </div>
    </div>
  </div>
</template>

<script>
import router from "@system.router"
import storage from "@system.storage"
import sensor from "@system.sensor"
import prompt from "@system.prompt"
import { setBaseX } from "../../util/calib"

export default {
  private: {
    controlMode: 0,
    showPanel: false,
    calibMsg: '',
    oTitle: 0,
    oAccent: 0,
    oSub: 0,
    oBtn1: 0,
    oBtn2: 0,
    oBtn3: 0
  },

  onInit() {
    var self = this
    storage.get({
      key: 'controlMode',
      success: function(data) {
        self.controlMode = parseInt(data) || 0
      }
    })
    this.introFade()
    setTimeout(function() {
      self.oTitle = 1; self.oAccent = 1; self.oSub = 1
      self.oBtn1 = 1; self.oBtn2 = 1; self.oBtn3 = 1
    }, 800)
  },

  introFade() {
    var self = this
    var seq = [['oTitle', 0], ['oAccent', 70], ['oSub', 140], ['oBtn1', 210], ['oBtn2', 280], ['oBtn3', 350]]
    for (var i = 0; i < seq.length; i++) {
      (function(k, delay) {
        setTimeout(function() { self.fadeIn(k) }, delay)
      })(seq[i][0], seq[i][1])
    }
  },

  fadeIn(key) {
    var self = this
    var step = function() {
      var v = self[key] + 0.2
      if (v >= 1) { self[key] = 1; return }
      self[key] = v
      setTimeout(step, 30)
    }
    step()
  },

  go() {
    router.push({
      uri: "/pages/level",
      params: { controlMode: this.controlMode }
    })
  },

  goRecords() {
    router.push({ uri: "/pages/record" })
  },

  onSwipe(e) {
    if (e.direction === 'left' || e.direction === 'down') {
      this.go()
    }
  },

  showSettings() {
    this.showPanel = true
  },

  hidePanel() {
    this.showPanel = false
  },

  stopProp() {},

  setGyro() {
    this.controlMode = 0
    storage.set({ key: 'controlMode', data: '0' })
  },

  setTouch() {
    this.controlMode = 1
    storage.set({ key: 'controlMode', data: '1' })
  },

  calibrate() {
    var self = this
    if (self._calibrating) return
    self._calibrating = true
    self._calibSum = 0
    self._calibN = 0
    try {
      sensor.subscribeAccelerometer({
        interval: 'game',
        callback: function(ret) {
          self._calibSum += ret.x
          self._calibN++
        }
      })
    } catch (e) {
      self._calibrating = false
      return
    }
    setTimeout(function() {
      try { sensor.unsubscribeAccelerometer() } catch (e) {}
      self._calibrating = false
      if (self._calibN > 0) {
        setBaseX(self._calibSum / self._calibN)
        self.calibMsg = '体感校准完成'
        try { prompt.showToast({ message: '体感校准完成' }) } catch (e) {}
      } else {
        self.calibMsg = '校准失败，请重试'
      }
      setTimeout(function() { self.calibMsg = '' }, 2000)
    }, 400)
  }
}
</script>


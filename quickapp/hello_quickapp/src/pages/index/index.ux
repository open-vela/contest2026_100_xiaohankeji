  background-color: #22c1e8;
  justify-content: center;
  align-items: center;
  margin-bottom: 18px;
}

.btn-text {
  font-size: 32px;
  color: #04222c;
}

.btn2 {
  width: 260px;
  height: 58px;
  border-radius: 29px;
  background-color: #14141c;
  border-width: 1px;
  border-style: solid;
  border-color: rgba(255,255,255,0.12);
  justify-content: center;
  align-items: center;
  margin-bottom: 14px;
}

.btn2-text {
  font-size: 25px;
  color: #f2f2f7;
}

.btn3 {
  width: 260px;
  height: 58px;
  border-radius: 29px;
  background-color: #14141c;
  border-width: 1px;
  border-style: solid;
  border-color: rgba(255,255,255,0.12);
  justify-content: center;
  align-items: center;
}

.btn3-text {
  font-size: 25px;
  color: #f2f2f7;
}

.panel {
  position: absolute;
  left: 0;
  top: 0;
  width: 480px;
  height: 480px;
  background-color: rgba(0,0,0,0.7);
  justify-content: center;
  align-items: center;
  z-index: 20;
}

.panel-box {
  width: 340px;
  background-color: #14141c;
  border-width: 1px;
  border-style: solid;
  border-color: rgba(255,255,255,0.1);
  border-radius: 28px;
  flex-direction: column;
  align-items: center;
  padding-top: 30px;
  padding-bottom: 30px;
}

.panel-title {
  font-size: 28px;
  color: #f2f2f7;
  margin-bottom: 24px;
}

.opt {
  width: 260px;
  height: 56px;
  border-radius: 28px;
  background-color: rgba(255,255,255,0.06);
  border-width: 1px;
  border-style: solid;
  border-color: rgba(255,255,255,0.08);
  justify-content: center;
  align-items: center;
  margin-bottom: 14px;
}

.opt-text {
  font-size: 24px;

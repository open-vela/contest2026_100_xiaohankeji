<template>
  <div class="page" onswipe="onSwipe">
    <text class="title">选择模式</text>
    <div class="list">
      <div class="lv lv1" onclick="go(1)">
        <text class="lv-text">繁殖模式</text>
        <text class="lv-sub" if="{{ bestBrTime > 0 }}">最佳时间: {{ bestBrTime }}秒</text>
        <text class="lv-sub" if="{{ bestBrTime === 0 }}">蓝球风暴</text>
      </div>
      <div class="lv lv2" onclick="go(2)">
        <text class="lv-text">极限模式</text>
        <text class="lv-sub" if="{{ bestExtTime > 0 }}">最佳时间: {{ bestExtTime }}秒</text>
        <text class="lv-sub" if="{{ bestExtTime === 0 }}">极速弹球</text>
      </div>
      <div class="lv lv3" onclick="go(3)">
        <text class="lv-text">血量模式</text>
        <text class="lv-sub" if="{{ bestHp > 0 }}">最高分: {{ bestHp }}分</text>
        <text class="lv-sub" if="{{ bestHp === 0 }}">生命与砖块</text>
      </div>
      <div class="lv lv4" onclick="go(4)">
        <text class="lv-text">狂野模式</text>
        <text class="lv-sub" if="{{ bestWild > 0 }}">最佳时间: {{ bestWild }}秒</text>
        <text class="lv-sub" if="{{ bestWild === 0 }}">移动砖来袭</text>
      </div>
    </div>
  </div>
</template>

<script>
import router from "@system.router"
import { loadStats } from "../../util/stats"

export default {
  protected: {
    controlMode: 0
  },
  private: {
    bestBrTime: 0,
    bestExtTime: 0,
    bestHp: 0,
    bestWild: 0
  },

  onInit() {
    var self = this
    this.controlMode = parseInt(this.controlMode) || 0
    loadStats(function(s) {
      self.bestBrTime = s.bestBrTime
      self.bestExtTime = s.bestExtTime
      self.bestHp = s.bestHp
      self.bestWild = s.bestWild
    })
  },

  go(level) {
    router.replace({
      uri: "/pages/game",
      params: { level: level, controlMode: this.controlMode }
    })
  },

  onSwipe(e) {
    if (e.direction === 'right') {
      router.back()
    }
  }
}
</script>

<style>
.page {
  width: 480px;
  height: 480px;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  background-color: #000000;
}

.title {
  font-size: 34px;
  color: #f2f2f7;
  margin-bottom: 30px;
}

.list {
  flex-direction: column;
  align-items: center;
}

.lv {
  width: 300px;
  height: 74px;
  border-radius: 32px;
  background-color: #14141c;
  border-left-width: 5px;
  border-left-style: solid;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  margin-bottom: 14px;
}

.lv1 {
  border-left-color: #b987ff;
}

.lv2 {
  border-left-color: #ffcc00;
}

.lv3 {
  border-left-color: #ff6b6b;
}

.lv4 {
  border-left-color: #22c1e8;
}

.lv-text {
  font-size: 27px;
  color: #f2f2f7;
}

.lv-sub {
  font-size: 15px;
  color: #8e8e93;
  margin-top: 3px;
}
</style>